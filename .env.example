# AI endi Vertex AI orqali ishlaydi (service account bilan) — GEMINI_API_KEY KERAK EMAS.
# api/ai.ts dagi VERTEX_PROJECT (gen-lang-client-0017562692) loyihasining service account JSON'i.
# Google Cloud Console > IAM > Service Accounts orqali JSON kalit yaratiladi va
# Vercel'da bitta qatorli secret sifatida saqlanadi.
GCP_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"gen-lang-client-0017562692",...}'

# Server-side Firebase Auth, barqaror rate limit va atomik video kreditlari uchun
# (gen-lang-client-0398801666 loyihasining service account JSON'i).
# Firebase Console > Project settings > Service accounts orqali JSON kalit yarating
# va Vercel'da bitta qatorli secret sifatida saqlang.
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"gen-lang-client-0398801666",...}'

# Vertex narxlari o'zgarsa kodni emas, shu qiymatlarni yangilang.
# Qiymatlar USD / 1 000 000 token; 2026-07-20 dagi rasmiy PayGo narxlari:
# Gemini 3 Flash Preview: $0.25 input, $1.50 output (response + reasoning).
# Gemini 3.1 Flash TTS Preview: $1 input text, $20 output audio.
# https://cloud.google.com/vertex-ai/generative-ai/pricing
# https://cloud.google.com/text-to-speech/pricing
VERTEX_TEXT_INPUT_USD_PER_1M_TOKENS="0.25"
VERTEX_TEXT_OUTPUT_USD_PER_1M_TOKENS="1.50"
VERTEX_TTS_INPUT_USD_PER_1M_TOKENS="1.00"
VERTEX_TTS_OUTPUT_USD_PER_1M_TOKENS="20.00"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
