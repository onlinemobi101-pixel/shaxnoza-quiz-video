rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Egasi (owner) emaili yoki Firestore'da role == 'admin' bo'lgan foydalanuvchi admin hisoblanadi
    function isOwnerEmail() {
      return request.auth != null && request.auth.token.email == 'onlinemobi101@gmail.com';
    }

    function isAdmin() {
      return isOwnerEmail() || (
        request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    match /users/{userId} {
      // O'qish: faqat o'z hujjati yoki admin
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // Yaratish: foydalanuvchi faqat o'ziga, faqat 'free' rol va 0 video bilan profil ochadi.
      // Egasi emaili istisno — u 'admin' rol bilan ochishi mumkin.
      allow create: if request.auth != null && request.auth.uid == userId && (
        isOwnerEmail() || (
          request.resource.data.keys().hasOnly(['role', 'videosCreated', 'premiumUntil', 'email', 'createdAt']) &&
          request.resource.data.role == 'free' &&
          request.resource.data.videosCreated == 0 &&
          request.resource.data.premiumUntil == null &&
          request.resource.data.email == request.auth.token.email
        )
      );

      // Video krediti va tarif faqat ishonchli server (Admin SDK) yoki admin tomonidan o'zgartiriladi.
      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    // API rate-limit hisoblagichlari faqat serverdagi Admin SDK uchun.
    match /apiUsage/{userId} {
      allow read, write: if false;
    }
  }
}
