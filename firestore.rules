rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin emaili yoki Firestore'da role == 'admin' bo'lgan foydalanuvchi admin hisoblanadi.
    //
    // DIQQAT: bu ro'yxat shared/admins.ts dagi ADMIN_EMAILS bilan bir xil bo'lishi SHART.
    // Rules TypeScript import qila olmaydi, shuning uchun sinxronlash qo'lda bajariladi.
    // O'zgartirgach: firebase deploy --only firestore:rules
    function isAdminEmail() {
      return request.auth != null && request.auth.token.email in [
        'onlinemobi101@gmail.com',
        'optombazar9@gmail.com'
      ];
    }

    function isAdmin() {
      return isAdminEmail() || (
        request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    match /users/{userId} {
      // O'qish: faqat o'z hujjati yoki admin
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // Yaratish: foydalanuvchi faqat o'ziga, faqat 'free' rol va 0 video bilan profil ochadi.
      // Admin emaillari istisno — ular 'admin' rol bilan ochishi mumkin.
      allow create: if request.auth != null && request.auth.uid == userId && (
        isAdminEmail() || (
          request.resource.data.keys().hasOnly([
            'role',
            'videosCreated',
            'premiumUntil',
            'quotaCycle',
            'quotaUsed',
            'quotaLimit',
            'email',
            'createdAt'
          ]) &&
          request.resource.data.role == 'free' &&
          request.resource.data.videosCreated == 0 &&
          request.resource.data.premiumUntil == null &&
          request.resource.data.quotaCycle == null &&
          request.resource.data.quotaUsed == 0 &&
          request.resource.data.quotaLimit == 1 &&
          request.resource.data.email == request.auth.token.email
        )
      );

      // Video krediti va tarif faqat ishonchli server (Admin SDK) yoki admin tomonidan o'zgartiriladi.
      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    // API rate-limit hisoblagichlari faqat serverdagi Admin SDK uchun.
    match /apiUsage/{userId} {
      allow read, write: if false;
    }

    // Eksport rezervatsiyalari va tannarx hodisalarini faqat server yozadi.
    match /exportReservations/{reservationId} {
      allow read: if request.auth != null &&
        (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /costEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Oylik umumiy ko'rsatkichlar admin dashboard uchun.
    match /usageMonths/{monthId} {
      allow read: if isAdmin();
      allow write: if false;

      match /users/{userId} {
        allow read: if request.auth != null &&
          (request.auth.uid == userId || isAdmin());
        allow write: if false;
      }
    }
  }
}
